  <diagram id="diagram-b" name="Diagram B – CI/CD Platform">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title-b" value="Diagram B — CI/CD Platform Architecture (AWS + Jenkins)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="760" height="40" as="geometry" />
        </mxCell>
        <!-- Developer -->
        <mxCell id="dev" value="Developer&#xa;pushes code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="180" height="60" as="geometry" />
        </mxCell>
        <!-- Git -->
        <mxCell id="git" value="Git Repository&#xa;GitHub / GitLab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="200" height="60" as="geometry" />
        </mxCell>
        <!-- Terraform provisioning -->
        <mxCell id="tf-prov" value="Terraform (IaC)&#xa;provisions Jenkins infra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="220" height="60" as="geometry" />
        </mxCell>
        <!-- Arrow: dev -> git -->
        <mxCell id="eb1" value="git push" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" source="dev" target="git" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Jenkins Platform VPC -->
        <mxCell id="j-vpc-rect" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0066CC;strokeWidth=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="1080" height="370" as="geometry" />
        </mxCell>
        <mxCell id="j-vpc-label" value="Jenkins platform VPC (private subnet)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#0066CC;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="208" width="320" height="20" as="geometry" />
        </mxCell>
        <!-- EC2 Jenkins box -->
        <mxCell id="ec2-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7B1FA2;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="235" width="400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ec2-label" value="EC2 instance (t3.medium)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#7B1FA2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="126" y="243" width="220" height="20" as="geometry" />
        </mxCell>
        <!-- Jenkins Controller -->
        <mxCell id="jenkins" value="Jenkins Controller&#xa;Pipelines, UI, scheduling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="270" width="340" height="60" as="geometry" />
        </mxCell>
        <!-- EBS -->
        <mxCell id="ebs" value="EBS Volume&#xa;Persistent Jenkins data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="360" width="340" height="60" as="geometry" />
        </mxCell>
        <!-- IAM Role -->
        <mxCell id="iam" value="IAM Role (least privilege)&#xa;ECR push, ECS deploy only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="450" width="340" height="60" as="geometry" />
        </mxCell>
        <!-- Access control box -->
        <mxCell id="ac-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#00897B;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="235" width="560" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ac-label" value="access control" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#00897B;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="576" y="243" width="150" height="20" as="geometry" />
        </mxCell>
        <!-- SSM -->
        <mxCell id="ssm" value="SSM Session Manager&#xa;No public SSH port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="270" width="490" height="60" as="geometry" />
        </mxCell>
        <!-- ALB Jenkins -->
        <mxCell id="alb-j" value="ALB + Jenkins built-in auth&#xa;UI access · HTTPS only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="360" width="490" height="60" as="geometry" />
        </mxCell>
        <!-- Security Group -->
        <mxCell id="sg" value="Security Group&#xa;Restrict inbound — no 0.0.0.0/0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="450" width="490" height="60" as="geometry" />
        </mxCell>
        <!-- Application infra box -->
        <mxCell id="app-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E65100;strokeWidth=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="1080" height="220" as="geometry" />
        </mxCell>
        <mxCell id="app-label" value="Application infrastructure (separate VPC / accounts)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#E65100;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="608" width="420" height="20" as="geometry" />
        </mxCell>
        <!-- ECR app -->
        <mxCell id="ecr-app" value="ECR&#xa;Docker image store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="110" y="640" width="230" height="60" as="geometry" />
        </mxCell>
        <!-- ECS app -->
        <mxCell id="ecs-app" value="ECS Fargate&#xa;dev + prod services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="640" width="230" height="60" as="geometry" />
        </mxCell>
        <!-- S3 TF state -->
        <mxCell id="s3-tf" value="S3 + DynamoDB&#xa;Remote Terraform state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="640" width="230" height="60" as="geometry" />
        </mxCell>
        <!-- Manual approval gate -->
        <mxCell id="approval" value="Manual Approval Gate&#xa;Required before prod deploy" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="730" width="380" height="70" as="geometry" />
        </mxCell>
        <!-- Arrows: git -> Jenkins (webhook) -->
        <mxCell id="eb2" value="webhook trigger" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" source="git" target="jenkins" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Terraform -> EC2 (provisions) -->
        <mxCell id="eb3" value="provisions" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#999999;fontSize=11;" edge="1" source="tf-prov" target="ec2-bg" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Jenkins -> ECR -->
        <mxCell id="eb4" value="push image" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" source="jenkins" target="ecr-app" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Jenkins -> ECS -->
        <mxCell id="eb5" value="deploy" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" source="jenkins" target="ecs-app" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Jenkins -> S3 TF -->
        <mxCell id="eb6" value="terraform apply" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" source="jenkins" target="s3-tf" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ECS -> approval -->
        <mxCell id="eb7" value="prod pipeline" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" source="ecs-app" target="approval" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
