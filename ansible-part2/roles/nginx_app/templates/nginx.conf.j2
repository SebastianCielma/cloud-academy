server {
    listen {{ base_port + item | int }};
    server_name _;

    access_log {{ nginx_access_log }};
    error_log {{ nginx_error_log }};

    root /var/www/html;
    index index.html;

    auth_basic "Restricted Access";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        try_files $uri $uri/ =404;
    }
}