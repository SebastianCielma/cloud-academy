[ca]
default_ca = CA_root

[CA_root]
dir               = /work/pki/out/root/db
database          = $dir/index.txt
new_certs_dir     = $dir/newcerts
certificate       = /work/pki/out/root/root-ca.crt
serial            = $dir/serial
crlnumber         = $dir/crlnumber
crl               = /work/pki/out/crl/root.crl.pem
private_key       = /work/pki/out/root/root-ca.key
default_md        = sha384
default_days      = 1095
default_crl_days  = 365
unique_subject    = no
policy            = policy_loose

[policy_loose]
countryName             = optional
stateOrProvinceName     = optional
organizationName        = optional
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

[crl_ext]
authorityKeyIdentifier = keyid:always
