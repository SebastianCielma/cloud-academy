apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: step-ca-acme
spec:
  acme:
    server: https://step-ca.step-ca.svc.cluster.local:9000/acme/acme-prov/directory
    caBundle: ${CA_BUNDLE}
    email: devops@internal.test
    privateKeySecretRef:
      name: step-ca-acme-account-key
    solvers:
      - http01:
          ingress:
            ingressClassName: nginx
