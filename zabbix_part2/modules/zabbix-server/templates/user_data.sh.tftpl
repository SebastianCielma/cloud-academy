#!/bin/bash
export DEBIAN_FRONTEND=noninteractive

# 0. Czekamy na zwolnienie blokad apt przez system operacyjny (rozwiązanie Race Condition)
while fuser /var/lib/apt/lists/lock >/dev/null 2>&1 || fuser /var/lib/dpkg/lock >/dev/null 2>&1 || fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; do
  sleep 3
done

# 1. Narzędzia podstawowe
apt-get update
apt-get install -y awscli wget postgresql

# 2. Dodanie repozytorium Zabbix przed instalacją pakietów!
wget https://repo.zabbix.com/zabbix/7.0/ubuntu/pool/main/z/zabbix-release/zabbix-release_7.0-2+ubuntu22.04_all.deb
dpkg -i zabbix-release_7.0-2+ubuntu22.04_all.deb
apt-get update

# 3. Instalacja komponentów Zabbix i serwera WWW
apt-get install -y zabbix-server-pgsql zabbix-frontend-php php8.1-pgsql zabbix-apache-conf zabbix-sql-scripts zabbix-agent

# 4. Pobranie hasła i konfiguracja bazy
DB_PASS=$(aws ssm get-parameter --region ${aws_region} --name "/zabbix/db/password" --with-decryption --query "Parameter.Value" --output text)

sudo -u postgres psql -c "CREATE USER zabbix WITH PASSWORD '$DB_PASS';"
sudo -u postgres psql -c "CREATE DATABASE zabbix OWNER zabbix;"
zcat /usr/share/zabbix-sql-scripts/postgresql/server.sql.gz | sudo -u zabbix psql zabbix

sed -i "s/# DBPassword=/DBPassword=$DB_PASS/" /etc/zabbix/zabbix_server.conf

# 5. Uruchomienie usług
systemctl restart zabbix-server zabbix-agent apache2 postgresql
systemctl enable zabbix-server zabbix-agent apache2 postgresql